# Скопируй в .env и заполни. Сам .env не коммитится (см. .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=

# Адрес сервиса PO token. Без него YouTube отвечает
# "Sign in to confirm you're not a bot" на запросы с IP дата-центра.
# docker compose:  http://pot-provider:4416
# Railway:         http://<имя-сервиса>.railway.internal:4416
POT_PROVIDER_URL=

# Пусто = api.telegram.org, лимит файла 50 МБ.
# Адрес локального Bot API Server = лимит 2 ГБ.
# ВАЖНО: на Railway оставить пустым, иначе контейнер стучится сам в себя.
LOCAL_API_BASE_URL=

# Нужны ТОЛЬКО локальному Bot API Server (docker compose).
# Получить: https://my.telegram.org -> API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Резервный обход блокировки, если PO token не помог.
# Файл cookies = полный доступ к аккаунту, используй одноразовый профиль.
COOKIES_FILE=cookies.txt
# Тот же файл в base64, для хостинга без доступа к ФС: base64 -w0 cookies.txt
YOUTUBE_COOKIES_B64=
